# Выбор СУБД: mongodb или postgres
DATABASE_DRIVER="mongodb"

# MongoDB
DATABASE_URL="mongodb://localhost:27017/prac"

# PostgreSQL
DATABASE_HOST="localhost"
DATABASE_PORT="5432"
DATABASE_USERNAME="film_user"
DATABASE_PASSWORD="film_password"
DATABASE_NAME="film"

# Логирование: console (DevLogger) | json | tskv
# Алиас: LOGGER_FORMAT (то же значение)
LOGGER_TYPE=console

# Прод: origins для CORS (через запятую). Если не задано — в коде зашиты film/backendfilm *.sergd.*
# CORS_ORIGINS=https://film.sergd.nomorepartiessite.ru,https://backendfilm.sergd.nomorepartiessite.ru

DEBUG=*
