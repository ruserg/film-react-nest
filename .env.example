# Образы GHCR (docker compose / CI). Подставьте свой логин GitHub в нижнем регистре.
GHCR_OWNER=ruserg

# --- Docker Compose: PostgreSQL (деплой и локальный docker) ---
POSTGRES_USER=student
POSTGRES_PASSWORD=student
POSTGRES_DB=film

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# --- Backend (в контейнере совпадают с Postgres) ---
DATABASE_DRIVER=postgres
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_USERNAME=student
DATABASE_PASSWORD=student
DATABASE_NAME=film

# Логирование: console | json | tskv
LOGGER_TYPE=console

# CORS для фронта на другом поддомене (опционально; иначе сработают дефолты в main.ts)
# CORS_ORIGINS=https://film.sergd.nomorepartiessite.ru,http://film.sergd.nomorepartiessite.ru

# --- Frontend (build args для Vite: как браузер ходит к API и к картинкам) ---
# Локально:
VITE_API_URL=http://localhost/api/afisha
VITE_CDN_URL=http://localhost/content/afisha

# Прод (Yandex Cloud, один IP на оба DNS): API на поддомене, статика через основной хост фронта
# Пока нет HTTPS — замените https:// на http://
# VITE_API_URL=https://backendfilm.sergd.nomorepartiessite.ru/api/afisha
# VITE_CDN_URL=https://film.sergd.nomorepartiessite.ru/content/afisha
